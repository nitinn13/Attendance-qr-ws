{
  "name": "qr-attendance-service",
  "version": "1.0.0",
  "description": "Stateless QR rotation service for attendance, delegating identity and persistence to the main backend.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.16.0",
    "typescript": "^5.9.3"
  }
}
