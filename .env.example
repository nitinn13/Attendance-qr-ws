# Port this QR service listens on
PORT=4000

NODE_ENV=development

# Base URL of the main backend (Express + Prisma) that owns
# Class / Session / Enrollment / Attendance, and exposes:
#   GET  /teacher/session/:id       (teacher JWT)
#   POST /student/mark-attendance   (student JWT, body { sessionId })
MAIN_API_URL=http://localhost:3000

# Lifecycle of a QR run, in milliseconds
QR_SESSION_DURATION_MS=30000
QR_TOKEN_REFRESH_MS=5000

# Comma-separated list of allowed origins for CORS.
# Leave unset in development to allow all origins.
# CORS_ORIGIN=https://your-frontend.example.com
